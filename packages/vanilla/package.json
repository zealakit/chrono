{
  "name": "@zealakit/chrono-vanilla",
  "version": "0.8.0",
  "description": "Headless Calendar, Date, Time and DateTime components for Vanilla JavaScript and TypeScript.",
  "keywords": [
    "chrono",
    "date",
    "time",
    "datetime",
    "calendar",
    "headless",
    "zealakit",
    "vanilla",
    "javascript",
    "typescript",
    "dom"
  ],
  "author": "nqhed - Huy Ed. Nguyen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zealakit/chrono.git",
    "directory": "packages/vanilla"
  },
  "homepage": "https://github.com/zealakit/chrono#readme",
  "bugs": {
    "url": "https://github.com/zealakit/chrono/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./date": {
      "types": "./dist/date/index.d.ts",
      "import": "./dist/date/index.js",
      "default": "./dist/date/index.js"
    },
    "./time": {
      "types": "./dist/time/index.d.ts",
      "import": "./dist/time/index.js",
      "default": "./dist/time/index.js"
    },
    "./datetime": {
      "types": "./dist/datetime/index.d.ts",
      "import": "./dist/datetime/index.js",
      "default": "./dist/datetime/index.js"
    },
    "./calendar": {
      "types": "./dist/calendar/index.d.ts",
      "import": "./dist/calendar/index.js",
      "default": "./dist/calendar/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@zealakit/chrono-core": "workspace:^"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "test": "pnpm build && node --import ./tests/setup.ts --test tests/*.test.ts",
    "test:watch": "node --import ./tests/setup.ts --test --watch tests/*.test.ts",
    "clean": "rm -rf dist",
    "prepack": "pnpm run build"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  }
}
