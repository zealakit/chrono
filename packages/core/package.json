{
  "name": "@zealakit/chrono-core",
  "version": "0.3.0",
  "private": true,
  "description": "Internal framework-independent calendar and date/time kernel. Private: bundled into each adapter package, never published to npm.",
  "keywords": [
    "chrono",
    "date",
    "time",
    "datetime",
    "calendar",
    "headless",
    "zealakit",
    "core"
  ],
  "author": "nqhed - Huy Ed. Nguyen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zealakit/chrono.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/zealakit/chrono#readme",
  "bugs": {
    "url": "https://github.com/zealakit/chrono/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./foundation": {
      "types": "./dist/foundation/index.d.ts",
      "import": "./dist/foundation/index.js",
      "default": "./dist/foundation/index.js"
    },
    "./calendar": {
      "types": "./dist/calendar/index.d.ts",
      "import": "./dist/calendar/index.js",
      "default": "./dist/calendar/index.js"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "test": "pnpm build && node scripts/test-tz.mjs",
    "test:watch": "node --import ./tests/setup.ts --test --watch tests/*.test.ts",
    "clean": "rm -rf dist",
    "prepack": "pnpm run build"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
