{
  "cases": [
    {
      "name": "time grid move: pointer 14:07 minus 20 min grab -> 13:45",
      "options": { "view": "time-grid", "snap": 15, "slot": 15 },
      "from": ["2026-11-17T10:00", "2026-11-17T11:00", false],
      "grab": { "dayOffset": 0, "minuteOffset": 20 },
      "target": { "date": "2026-11-19", "time": "14:07" },
      "expected": ["2026-11-19T13:45", "2026-11-19T14:45", false]
    },
    {
      "name": "time grid move: 14:13 -> raw 13:53 rounds to 14:00",
      "options": { "view": "time-grid", "snap": 15, "slot": 15 },
      "from": ["2026-11-17T10:00", "2026-11-17T11:00", false],
      "grab": { "dayOffset": 0, "minuteOffset": 20 },
      "target": { "date": "2026-11-19", "time": "14:13" },
      "expected": ["2026-11-19T14:00", "2026-11-19T15:00", false]
    },
    {
      "name": "time grid move: an exact tie rounds up",
      "options": { "view": "time-grid", "snap": 30, "slot": 15 },
      "from": ["2026-11-17T10:00", "2026-11-17T11:00", false],
      "grab": { "dayOffset": 0, "minuteOffset": 0 },
      "target": { "date": "2026-11-17", "time": "09:15" },
      "expected": ["2026-11-17T09:30", "2026-11-17T10:30", false]
    },
    {
      "name": "month move keeps the span: grabbed on day 2 of 3, dropped Nov 26",
      "options": { "view": "month", "snap": 30, "slot": 30 },
      "from": ["2026-11-16T00:00", "2026-11-19T00:00", true],
      "grab": { "dayOffset": 1, "minuteOffset": 0 },
      "target": { "date": "2026-11-26" },
      "expected": ["2026-11-25T00:00", "2026-11-28T00:00", true]
    },
    {
      "name": "month move of a timed event keeps its time of day",
      "options": { "view": "month", "snap": 30, "slot": 30 },
      "from": ["2026-11-17T09:30", "2026-11-17T10:30", false],
      "grab": { "dayOffset": 0, "minuteOffset": 0 },
      "target": { "date": "2026-11-20" },
      "expected": ["2026-11-20T09:30", "2026-11-20T10:30", false]
    },
    {
      "name": "timed to all-day row: a 2 h event becomes one day",
      "options": { "view": "time-grid", "snap": 30, "slot": 30 },
      "from": ["2026-11-17T10:00", "2026-11-17T12:00", false],
      "grab": { "dayOffset": 0, "minuteOffset": 0 },
      "target": { "date": "2026-11-18", "allDayRow": true },
      "expected": ["2026-11-18T00:00", "2026-11-19T00:00", true]
    },
    {
      "name": "timed to all-day row: a 30 h event becomes two days",
      "options": { "view": "time-grid", "snap": 30, "slot": 30 },
      "from": ["2026-11-17T10:00", "2026-11-18T16:00", false],
      "grab": { "dayOffset": 0, "minuteOffset": 0 },
      "target": { "date": "2026-11-20", "allDayRow": true },
      "expected": ["2026-11-20T00:00", "2026-11-22T00:00", true]
    },
    {
      "name": "all-day to the timed area: default duration 60",
      "options": { "view": "time-grid", "snap": 30, "slot": 30 },
      "from": ["2026-11-17T00:00", "2026-11-18T00:00", true],
      "grab": { "dayOffset": 0, "minuteOffset": 0 },
      "target": { "date": "2026-11-18", "time": "09:00" },
      "expected": ["2026-11-18T09:00", "2026-11-18T10:00", false]
    },
    {
      "name": "conversion switched off rejects the target",
      "options": {
        "view": "time-grid",
        "snap": 30,
        "slot": 30,
        "allowAllDayConversion": false
      },
      "from": ["2026-11-17T00:00", "2026-11-18T00:00", true],
      "grab": { "dayOffset": 0, "minuteOffset": 0 },
      "target": { "date": "2026-11-18", "time": "09:00" },
      "expected": null
    }
  ],
  "resize": [
    {
      "name": "end handle to the slot 12:00 reaches the end of that slot",
      "options": { "view": "time-grid", "snap": 30, "slot": 30 },
      "from": ["2026-11-17T10:00", "2026-11-17T11:00", false],
      "edge": "end",
      "target": { "date": "2026-11-17", "time": "12:00" },
      "expected": ["2026-11-17T10:00", "2026-11-17T12:30", false]
    },
    {
      "name": "end handle onto the next column extends past midnight",
      "options": { "view": "time-grid", "snap": 30, "slot": 30 },
      "from": ["2026-11-17T22:00", "2026-11-17T23:00", false],
      "edge": "end",
      "target": { "date": "2026-11-18", "time": "01:00" },
      "expected": ["2026-11-17T22:00", "2026-11-18T01:30", false]
    },
    {
      "name": "end handle dragged above the start stops one snap after it",
      "options": { "view": "time-grid", "snap": 30, "slot": 30 },
      "from": ["2026-11-17T10:00", "2026-11-17T11:00", false],
      "edge": "end",
      "target": { "date": "2026-11-17", "time": "08:00" },
      "expected": ["2026-11-17T10:00", "2026-11-17T10:30", false]
    },
    {
      "name": "start handle never crosses the end",
      "options": { "view": "time-grid", "snap": 30, "slot": 30 },
      "from": ["2026-11-17T10:00", "2026-11-17T11:00", false],
      "edge": "start",
      "target": { "date": "2026-11-17", "time": "15:00" },
      "expected": ["2026-11-17T10:30", "2026-11-17T11:00", false]
    },
    {
      "name": "all-day end handle moves by whole days, minimum one day",
      "options": { "view": "month", "snap": 30, "slot": 30 },
      "from": ["2026-11-16T00:00", "2026-11-18T00:00", true],
      "edge": "end",
      "target": { "date": "2026-11-20" },
      "expected": ["2026-11-16T00:00", "2026-11-21T00:00", true]
    },
    {
      "name": "all-day end handle left of the start keeps one day",
      "options": { "view": "month", "snap": 30, "slot": 30 },
      "from": ["2026-11-16T00:00", "2026-11-18T00:00", true],
      "edge": "end",
      "target": { "date": "2026-11-10" },
      "expected": ["2026-11-16T00:00", "2026-11-17T00:00", true]
    }
  ]
}
