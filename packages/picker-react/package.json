{
  "name": "@zealakit/chrono-picker-react",
  "version": "1.0.0-beta.1",
  "description": "Ready-made date, time and date-time pickers for React: Chrono inputs and panels in an Overlay popover.",
  "keywords": [
    "chrono",
    "datepicker",
    "timepicker",
    "datetime",
    "picker",
    "headless",
    "zealakit",
    "react"
  ],
  "author": "nqhed - Huy Ed. Nguyen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zealakit/chrono.git",
    "directory": "packages/picker-react"
  },
  "homepage": "https://github.com/zealakit/chrono#readme",
  "bugs": {
    "url": "https://github.com/zealakit/chrono/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@zealakit/chrono-react": "workspace:^",
    "@zealakit/overlay-react": "^1.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@zealakit/chrono-react": "workspace:^",
    "@zealakit/overlay-react": "^1.0.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "test": "pnpm build && node --import ./tests/setup.ts --test tests/*.test.ts",
    "clean": "rm -rf dist",
    "prepack": "pnpm run build"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  }
}
