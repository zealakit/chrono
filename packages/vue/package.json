{
  "name": "@zealakit/chrono-vue",
  "version": "0.1.0",
  "description": "Headless Calendar, Date, Time and DateTime components for Vue.",
  "keywords": [
    "chrono",
    "date",
    "time",
    "datetime",
    "calendar",
    "headless",
    "zealakit",
    "vue",
    "vue3",
    "composable"
  ],
  "author": "nqhed - Huy Ed. Nguyen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zealakit/chrono.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/zealakit/chrono#readme",
  "bugs": {
    "url": "https://github.com/zealakit/chrono/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@zealakit/chrono-core": "workspace:^"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.6.0",
    "happy-dom": "^21.0.4",
    "vue": "^3.5.45"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "test": "pnpm build && node --import ./tests/setup.ts --test tests/*.test.ts",
    "test:watch": "node --import ./tests/setup.ts --test --watch tests/*.test.ts",
    "clean": "rm -rf dist",
    "prepack": "pnpm run build"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  }
}
